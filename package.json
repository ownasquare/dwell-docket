{
  "name": "dwell-docket",
  "version": "0.1.0",
  "description": "Find detention owed, recovered, and blocked by missing evidence from one stop CSV.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "env -u NO_COLOR playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run test && npm run format:check && npm run lint && npm run typecheck && npm run audit:secrets && npm run audit:license && npm audit --audit-level=high && npm run test:e2e",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "audit:license": "node scripts/license-audit.mjs"
  },
  "files": [
    "index.html",
    "server.mjs",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "prettier": "3.6.2",
    "typescript": "5.8.3"
  }
}
